# CCE — Capital Control Engine
# Copy to `.env`. Every value below is a DEFAULT, not a requirement:
# with no .env at all the demo runs offline, with no API key, from the
# committed cache. That is the point — see docs/CLAUDE.md, DATA.

# ── Data ─────────────────────────────────────────────────────
# cached | live. CACHED is the default and the demo must work on it:
# no network, no API key. `live` falls back to cache on failure and the
# UI marks the result CACHED_FALLBACK rather than hiding it.
CCE_DATA_PROVIDER=cached

# ── LLM (explanation only) ───────────────────────────────────
# The LLM writes prose and never decisions. With this false, or with no
# key set, the deterministic narrator produces the full briefing and the
# system loses no functionality (FR-146).
CCE_LLM_ENABLED=false
# CCE_LLM_API_KEY=sk-ant-...        # never commit a real key

# ── Paths ────────────────────────────────────────────────────
# Relative paths resolve against the project root.
CCE_DB_PATH=./data/cce.db
CCE_POLICY_FILE=./config/policy.yaml
CCE_UNIVERSE_FILE=./config/universe.yaml
CCE_SCENARIOS_FILE=./config/scenarios.yaml

# ── Reproducibility ──────────────────────────────────────────
# Seeds every stochastic routine. Changing it changes results (NFR-012).
CCE_RANDOM_SEED=42

# ── Logging ──────────────────────────────────────────────────
CCE_LOG_LEVEL=INFO
